# Copy to .env. Never commit the real .env.
# Leave empty in dev (admin routes open). Set a long random value for any shared demo.
SAFESIGNAL_ADMIN_KEY=

# AI assistant (OpenRouter). Key stays server-side only.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Abuse protection (in-memory, per client address). Defaults shown.
# SAFESIGNAL_REPORT_RATE_LIMIT=10 / SAFESIGNAL_REPORT_RATE_WINDOW=3600  (new reports per window)
# SAFESIGNAL_ADMIN_FAIL_LIMIT=5 / SAFESIGNAL_ADMIN_FAIL_WINDOW=900      (failed admin attempts)
# Behind a reverse proxy see the note at the top of ratelimit.py.

# PostgreSQL (see DATABASE.md). Unset = in-memory, development only.
# DATABASE_URL=postgresql://safesignal_app:CHANGE_ME@127.0.0.1:5432/safesignal
# DATABASE_MIGRATE_URL=postgresql://safesignal_owner:CHANGE_ME@127.0.0.1:5432/safesignal
# SAFESIGNAL_ENV=production   # requires DATABASE_URL
